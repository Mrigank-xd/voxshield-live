# VOXSHIELD LIVE - ENVIRONMENT CONFIGURATION

# Application
PROJECT_NAME="VOXSHIELD LIVE"
VERSION="1.0.0"
API_PREFIX="/api"
SECRET_KEY="voxshield-hackathon-secure-secret-key-2026"

# Database (Default local SQLite, or PostgreSQL connection string)
DATABASE_URL="sqlite:///./voxshield.db"
# DATABASE_URL="postgresql://voxshield:voxshield_password@localhost:5432/voxshield_db"

# Risk Thresholds
RISK_THRESHOLD_LOW=29
RISK_THRESHOLD_MEDIUM=30
RISK_THRESHOLD_HIGH=60
RISK_THRESHOLD_CRITICAL=80
CHALLENGE_AUTO_TRIGGER_RISK=65

# Signal Layer Fusion Weights (Sum to 1.0)
WEIGHT_VOICE_CLONE=0.25
WEIGHT_SCAM_INTENT=0.25
WEIGHT_SPEAKER_MATCH=0.15
WEIGHT_LIP_SYNC=0.15
WEIGHT_FACE_AUTH=0.10
WEIGHT_REPLAY=0.10

# Privacy Preservation
PRIVACY_MODE_DEFAULT=false
RETAIN_RAW_AUDIO_HOURS=0 # 0 = Ephemeral zero-storage guarantee
DATA_RETENTION_DAYS=30

# WebRTC STUN/TURN
STUN_SERVER="stun:stun.l.google.com:19302"
